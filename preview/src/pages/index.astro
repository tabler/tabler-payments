---
import fs from 'node:fs';
import path from 'node:path';
import '@tabler/core/dist/css/tabler.css';
import payments from '../../../payments.json';

interface Provider {
  name: string;
  logo: string;
}

// `import.meta.url` cannot be used here: during `astro build` the frontmatter
// is bundled into a chunk under dist/.prerender/, so a URL relative to it
// resolves to the wrong directory. `process.cwd()` is reliable instead — both
// `astro dev` and `astro build` always run with this package's own directory
// (`preview/`) as the working directory.
const SRC_DIR = path.resolve(process.cwd(), '../src');

const listSlugs = (variant: 'light' | 'dark'): string[] =>
  fs
    .readdirSync(`${SRC_DIR}/${variant}`)
    .filter((f) => f.endsWith('.svg'))
    .map((f) => f.slice(0, -'.svg'.length));

const readSvg = (variant: 'light' | 'dark', slug: string): string =>
  fs.readFileSync(`${SRC_DIR}/${variant}/${slug}.svg`, 'utf-8');

const titleFromSlug = (slug: string): string =>
  slug
    .split('-')
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
    .join(' ');

const registry = new Map((payments as Provider[]).map((p) => [p.logo, p]));
const lightSlugs = listSlugs('light');
const darkSlugs = new Set(listSlugs('dark'));

// The page is driven by what is actually on disk, not by payments.json, so the
// count it reports always matches the number of logos rendered below. Anything
// that exists in only one of the two sources is called out in the summary
// instead of being silently dropped.
const providers = lightSlugs
  .filter((slug) => darkSlugs.has(slug))
  .map((slug) => ({
    slug,
    name: registry.get(slug)?.name ?? titleFromSlug(slug),
    registered: registry.has(slug),
  }))
  .sort((a, b) => a.slug.localeCompare(b.slug));

const unregistered = providers.filter((p) => !p.registered).map((p) => p.slug);
const incomplete = lightSlugs.filter((slug) => !darkSlugs.has(slug));
const missing = (payments as Provider[])
  .filter((p) => !lightSlugs.includes(p.logo) || !darkSlugs.has(p.logo))
  .map((p) => p.logo);

const issues: { label: string; slugs: string[] }[] = [
  { label: 'SVG pair on disk with no payments.json entry', slugs: unregistered },
  { label: 'payments.json entry with no SVG yet', slugs: missing },
  { label: 'light SVG with no dark counterpart', slugs: incomplete },
].filter((issue) => issue.slugs.length > 0);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>tabler-payments — provider preview</title>
    <style>
      /* These logos are fixed-size brand marks, not currentColor icons — give
         them a stable box instead of stretching to Tabler's default avatar
         square, which assumes a 1:1 icon. */
      .payment-logo {
        display: inline-flex;
        align-items: center;
        height: 3rem;
        flex: none;
      }

      .payment-logo :global(svg) {
        height: 100%;
        width: 100%;
      }
    </style>
  </head>
  <body>
    <div class="page">
      <div class="page-wrapper">
        <div class="page-header d-print-none container-xl mt-4">
          <h2 class="page-title">Payment providers</h2>
          <div class="text-secondary mt-1">
            {providers.length} logos on disk (light + dark) — {providers.length - unregistered.length} of them listed
            in payments.json, which has {(payments as Provider[]).length} entries.
          </div>
        </div>

        <div class="page-body">
          <div class="container-xl">
            <div class="row row-cards">
              {
                issues.length > 0 && (
                  <div class="col-12">
                    <div class="card">
                      <div class="card-header">
                        <div>
                          <h3 class="card-title">Data mismatches</h3>
                          <div class="card-subtitle">
                            payments.json and src/ are out of sync. Every logo below is still rendered.
                          </div>
                        </div>
                      </div>
                      <div class="list-group list-group-flush">
                        {issues.map((issue) => (
                          <div class="list-group-item">
                            <strong class="d-block">
                              {issue.slugs.length} × {issue.label}
                            </strong>
                            <div class="mt-1">
                              {issue.slugs.map((slug) => (
                                <code class="me-2">{slug}</code>
                              ))}
                            </div>
                          </div>
                        ))}
                      </div>
                    </div>
                  </div>
                )
              }

              <div class="col-12">
                <div class="card">
                  <div class="card-header">
                    <div>
                      <h3 class="card-title">Light background</h3>
                      <div class="card-subtitle">Provider logos on a light background, for use on white or light cards.</div>
                    </div>
                    <div class="card-actions">
                      <span class="badge bg-blue-lt">{providers.length}</span>
                    </div>
                  </div>
                  <div class="card-body">
                    <div class="row g-5 row-cols-5">
                      {
                        providers.map((p) => (
                          <div class="col">
                            <div class="row">
                              <div class="col-auto">
                                <span class="payment-logo rounded border overflow-hidden" set:html={readSvg('light', p.slug)} />
                              </div>
                              <div class="col">
                                <strong class="d-block">{p.name}</strong>
                                <div class="mt-1">
                                  <code>{p.slug}</code>
                                  {!p.registered && <span class="badge bg-yellow-lt ms-1">unlisted</span>}
                                </div>
                              </div>
                            </div>
                          </div>
                        ))
                      }
                    </div>
                  </div>
                </div>
              </div>

              <div class="col-12">
                <div class="card">
                  <div class="card-header">
                    <div>
                      <h3 class="card-title">Dark background</h3>
                      <div class="card-subtitle">Provider logos with an inverted color scheme, for dark backgrounds.</div>
                    </div>
                    <div class="card-actions">
                      <span class="badge bg-blue-lt">{providers.length}</span>
                    </div>
                  </div>
                  <div class="card-body">
                    <div class="row g-5 row-cols-5">
                      {
                        providers.map((p) => (
                          <div class="col">
                            <div class="row">
                              <div class="col-auto">
                                <span class="payment-logo rounded border overflow-hidden" set:html={readSvg('dark', p.slug)} />
                              </div>
                              <div class="col">
                                <strong class="d-block">{p.name}</strong>
                                <div class="mt-1">
                                  <code>{p.slug}-dark</code>
                                  {!p.registered && <span class="badge bg-yellow-lt ms-1">unlisted</span>}
                                </div>
                              </div>
                            </div>
                          </div>
                        ))
                      }
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
