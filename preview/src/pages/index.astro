---
import fs from 'node:fs';
import path from 'node:path';
import '@tabler/core/dist/css/tabler.css';
import payments from '../../../payments.json';

interface Provider {
  name: string;
  logo: string;
}

// `import.meta.url` cannot be used here: during `astro build` the frontmatter
// is bundled into a chunk under dist/.prerender/, so a URL relative to it
// resolves to the wrong directory. `process.cwd()` is reliable instead — both
// `astro dev` and `astro build` always run with this package's own directory
// (`preview/`) as the working directory.
const SRC_DIR = path.resolve(process.cwd(), '../src');

const readSvg = (variant: 'light' | 'dark', slug: string): string | null => {
  const file = `${SRC_DIR}/${variant}/${slug}.svg`;
  return fs.existsSync(file) ? fs.readFileSync(file, 'utf-8') : null;
};

const all = payments as Provider[];

// Same reconciliation the package builds do: skip providers with no SVG yet
// instead of failing, so the page still renders while assets catch up.
const missing: string[] = [];
const providers = all.filter((p) => {
  const ok = readSvg('light', p.logo) !== null && readSvg('dark', p.logo) !== null;
  if (!ok) missing.push(p.logo);
  return ok;
});

if (missing.length) {
  console.warn(`[preview] Skipping ${missing.length} provider(s) with no SVG yet: ${missing.join(', ')}`);
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>tabler-payments — provider preview</title>
    <style>
      /* These logos are fixed-size brand marks, not currentColor icons — give
         them a stable box instead of stretching to Tabler's default avatar
         square, which assumes a 1:1 icon. */
      .payment-logo {
        display: inline-flex;
        align-items: center;
        height: 2rem;
        width: 3.325rem;
        flex: none;
      }

      .payment-logo :global(svg) {
        height: 100%;
        width: 100%;
      }
    </style>
  </head>
  <body>
    <div class="page">
      <div class="page-wrapper">
        <div class="page-header d-print-none container-xl mt-4">
          <h2 class="page-title">Payment providers</h2>
          <div class="text-secondary mt-1">
            {providers.length} of {all.length} providers have an SVG on both light and dark background{missing.length ? ` (${missing.length} pending)` : ''}.
          </div>
        </div>

        <div class="page-body">
          <div class="container-xl">
            <div class="row row-cards">
              <div class="col-12">
                <div class="card">
                  <div class="card-header">
                    <div>
                      <h3 class="card-title">Light background</h3>
                      <div class="card-subtitle">Provider logos on a light background, for use on white or light cards.</div>
                    </div>
                  </div>
                  <div class="card-body">
                    <div class="row g-5 row-cols-5">
                      {
                        providers.map((p) => (
                          <div class="col">
                            <div class="row">
                              <div class="col-auto">
                                <span class="payment-logo" set:html={readSvg('light', p.logo)} />
                              </div>
                              <div class="col">
                                <strong class="d-block">{p.name}</strong>
                                <div class="mt-1">
                                  <code>{p.logo}</code>
                                </div>
                              </div>
                            </div>
                          </div>
                        ))
                      }
                    </div>
                  </div>
                </div>
              </div>

              <div class="col-12">
                <div class="card">
                  <div class="card-header">
                    <div>
                      <h3 class="card-title">Dark background</h3>
                      <div class="card-subtitle">Provider logos with an inverted color scheme, for dark backgrounds.</div>
                    </div>
                  </div>
                  <div class="card-body">
                    <div class="row g-5 row-cols-5">
                      {
                        providers.map((p) => (
                          <div class="col">
                            <div class="row">
                              <div class="col-auto">
                                <span class="payment-logo" set:html={readSvg('dark', p.logo)} />
                              </div>
                              <div class="col">
                                <strong class="d-block">{p.name}</strong>
                                <div class="mt-1">
                                  <code>{p.logo}-dark</code>
                                </div>
                              </div>
                            </div>
                          </div>
                        ))
                      }
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
