{
  "name": "tabler-payments",
  "version": "0.1.0",
  "description": "Payment provider logo components for React.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tabler/tabler-payments.git"
  },
  "private": true,
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "import-payments": "node ./.build/import-payments.mjs",
    "clean": "turbo run clean",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "build": "pnpm run build:packages && pnpm run typecheck",
    "build:packages": "pnpm run build:react",
    "build:react": "pnpm --filter @tabler/payments-react build",
    "changelog": "node ./.build/changelog.mjs",
    "release": "git pull && GITHUB_TOKEN=${GITHUB_TOKEN:-$(gh auth token)} release-it --verbose"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-node-resolve": "^16.0.3",
    "fs-extra": "^11.2.0",
    "glob": "^10.3.10",
    "release-it": "21.0.0",
    "rollup": "4.54.0",
    "rollup-plugin-dts": "6.3.0",
    "rollup-plugin-esbuild": "6.2.1",
    "rollup-plugin-license": "3.6.0",
    "rollup-plugin-visualizer": "^6.0.5",
    "slash": "^5.1.0",
    "svgo": "^3.2.0",
    "svgson": "^5.3.1",
    "turbo": "^2.10.7",
    "typescript": "5.9.3"
  },
  "release-it": {
    "npm": false,
    "hooks": {
      "before:init": [
        "npm whoami || (echo 'You are not logged in to npm. Run `npm login` first.' && exit 1)",
        "gh auth status || (echo 'You are not logged in to GitHub. Run `gh auth login` first.' && exit 1)"
      ],
      "after:bump": "npm version ${version} --no-git-tag-version --allow-same-version && pnpm -r --filter './packages/*' exec npm version ${version} --no-git-tag-version --allow-same-version && pnpm run build && pnpm install",
      "after:github:release": "pnpm -r publish --tag latest --no-git-checks",
      "after:release": "echo Successfully released ${name} v${version} to ${repo.repository}."
    },
    "git": {
      "addUntrackedFiles": true,
      "changelog": "LATEST_VERSION=${latestTag} pnpm run --silent changelog",
      "tagName": "v${version}",
      "requireBranch": "main",
      "requireCommits": true,
      "requireCleanWorkingDir": false
    },
    "github": {
      "release": true,
      "releaseNotes": "LATEST_VERSION=${latestTag} pnpm run --silent changelog"
    }
  },
  "packageManager": "pnpm@10.30.3",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
