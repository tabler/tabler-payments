{
  "name": "@tabler/payments-react",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Payment provider logos as React components.",
  "homepage": "https://github.com/tabler/tabler-payments",
  "bugs": {
    "url": "https://github.com/tabler/tabler-payments/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tabler/tabler-payments.git",
    "directory": "packages/payments-react"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/cjs/tabler-payments-react.cjs",
  "module": "./dist/esm/tabler-payments-react.mjs",
  "types": "./dist/tabler-payments-react.d.ts",
  "exports": {
    ".": {
      "types": "./dist/tabler-payments-react.d.ts",
      "import": "./dist/esm/tabler-payments-react.mjs",
      "require": "./dist/cjs/tabler-payments-react.cjs"
    },
    "./package.json": "./package.json"
  },
  "amdName": "TablerPaymentsReact",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "keywords": [
    "payments",
    "svg",
    "react",
    "checkout",
    "icons"
  ],
  "scripts": {
    "build": "pnpm run clean && pnpm run copy:license && pnpm run build:payments && pnpm run typecheck && pnpm run build:bundles",
    "build:payments": "node build.mjs",
    "build:bundles": "rollup -c ./rollup.config.mjs",
    "copy:license": "cp ../../LICENSE ./LICENSE",
    "clean": "rm -rf dist && find . ! -name '.gitkeep' -path '*/src/payments/*' -exec rm -rf {} +",
    "test": "vitest run --typecheck",
    "typecheck": "tsc"
  },
  "dependencies": {},
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "16.3.1",
    "@types/react": "19.2.18",
    "@vitejs/plugin-react": "5.1.2",
    "jest-serializer-html": "^7.1.0",
    "jsdom": "27.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vitest": "^4.0.16"
  },
  "peerDependencies": {
    "react": ">= 16"
  },
  "optionalDependencies": {}
}
